{
    "legendBox": { "borderColor": "gray", "defaultTextColor": "cyan" },
    "infoBox": { "borderColor": "blue", "defaultKeyColor": "#c0c0c0", "valueColor": "green" },
    "barRows": {
        "undoneSoFarColor": "cyan",
        "dotColors": {
            "commit": "blue",
            "snapshot": "green",
            "edit": "yellow",
            "write": "yellow",
            "read": "gray",
            "script": "magenta",
            "disk": "white",
            "deleted": "white",
            "created": "white"
        }
    },
    "markerBox": { "borderColor": "gray", "markedColor": "yellow", "arrowColor": "white", "timeColor": "green" },
    "fileViewBox": {
        "lineNumberColor": "gray",
        "textColor": "white",
        "tokenColors": {
            "hljs-keyword": "magenta",
            "hljs-string": "green",
            "hljs-comment": "gray",
            "hljs-number": "yellow",
            "hljs-literal": "yellow",
            "hljs-title": "blue",
            "hljs-built_in": "cyan",
            "hljs-type": "cyan",
            "hljs-attr": "cyan"
        }
    },
    "diffBox": { "textColor": "white", "lineNumberColor": "gray", "newerOnlyBackgroundColor": "#1f4d2b", "markerOnlyBackgroundColor": "#5a2424", "changedBackgroundColor": "#4d4a1f" },
    "consoleBox": { "summaryColor": "yellow", "rawColor": "white" },
    "globalHotKeysBox": {
        "defaultKeyColor": "#c0c0c0",
        "defaultLabelColor": "cyan",
        "borderColor": "gray",
        "keys": {
            "up": { "action": "moveSelectionUp", "key": "upArrow", "text": "up", "customColor": null },
            "down": { "action": "moveSelectionDown", "key": "downArrow", "text": "down", "customColor": null },
            "left": { "action": "stepSelectionTowardsNow", "key": "leftArrow", "text": "left", "customColor": null },
            "right": { "action": "stepSelectionTowardsEarliest", "key": "rightArrow", "text": "right", "customColor": null },
            "shiftLeft": { "action": "stepAllTowardsNow", "key": "leftArrow", "shift": true, "text": "shift-left", "customColor": null },
            "shiftRight": { "action": "stepAllTowardsEarliest", "key": "rightArrow", "shift": true, "text": "shift-right", "customColor": null },
            "select": { "action": "toggleSelection", "input": "s", "text": "(de)select", "customColor": null },
            "selectMultiple": { "action": "extendSelection", "input": "S", "text": "select multiple", "customColor": null },
            "resetSelected": { "action": "resetSelectedStores", "input": "r", "text": "reset selected store", "customColor": null },
            "resetAll": { "action": "resetAllStores", "input": "R", "text": "reset all stores", "customColor": null },
            "eventSpeed": { "action": "setEventSpeed", "input": "e", "text": "Step by 1 event", "customColor": null },
            "daySpeed": { "action": "toggleDaySpeed", "input": "d", "text": "Step by 1 Day", "customColor": null },
            "weekSpeed": { "action": "toggleWeekSpeed", "input": "w", "text": "Step by 1 week", "customColor": null },
            "viewFile": { "action": "viewFile", "input": "v", "text": "View file", "customColor": null },
            "reconstruct": { "action": "reconstructUntilEarliest", "input": "g", "text": "reconstruct file until Earliest", "customColor": null },
            "console": { "action": "openConsole", "input": "c", "text": "engine console", "customColor": null },
            "playScript": { "action": "playScript", "input": "p", "text": "play script", "customColor": null }
        }
    },
    "fileViewHotKeysBox": {
        "defaultKeyColor": "#c0c0c0",
        "defaultLabelColor": "cyan",
        "borderColor": "gray",
        "keys": {
            "up": { "action": "scrollUp", "key": "upArrow", "text": "scroll up", "customColor": null },
            "down": { "action": "scrollDown", "key": "downArrow", "text": "scroll down", "customColor": null },
            "close": { "action": "closeBox", "input": "c", "text": "close", "customColor": null },
            "diff": { "action": "toggleDiffView", "input": "f", "text": "diff", "customColor": null },
            "right": { "action": "viewFileStepTowardsEarliest", "key": "rightArrow", "text": "towards earlier", "customColor": null },
            "left": { "action": "viewFileStepTowardsNow", "key": "leftArrow", "text": "towards Now", "customColor": null },
            "day": { "action": "toggleDaySpeed", "input": "d", "text": "step by 1 day", "customColor": null },
            "week": { "action": "toggleWeekSpeed", "input": "w", "text": "step by 1 week", "customColor": null }
        }
    },
    "consoleHotKeysBox": {
        "defaultKeyColor": "#c0c0c0",
        "defaultLabelColor": "cyan",
        "borderColor": "gray",
        "keys": {
            "up": { "action": "scrollUp", "key": "upArrow", "text": "scroll up", "customColor": null },
            "down": { "action": "scrollDown", "key": "downArrow", "text": "scroll down", "customColor": null },
            "close": { "action": "closeBox", "input": "c", "text": "close", "customColor": null },
            "openLogFolder": { "action": "openLogFolder", "input": "o", "text": "open log folder", "customColor": null }
        }
    }
}
