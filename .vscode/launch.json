{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (demo bundle, port 7343)",
            "preLaunchTask": "prep:demo",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/viewer_server.ts",
            "args": ["--port", "7343", "--projects-dir", "demo/projects", "--file-history-dir", "demo/file-history"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (~/.claude/projects, port 7343)",
            "preLaunchTask": "build:webapp",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/viewer_server.ts",
            "args": ["--port", "7343", "--projects-dir", "${userHome}/.claude/projects"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        }
    ]
}
